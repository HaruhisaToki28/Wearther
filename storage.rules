rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Posts: Public read, User write own
    // Matches files like: posts/USER_ID/IMAGE_ID.jpg
    match /posts/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Avatars: Public read, User write own
    // Matches files like: avatars/USER_ID.jpg
    // Note: We cannot use {userId}.jpg in the match path, so we match {fileName} and check it in the condition.
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && fileName == request.auth.uid + '.jpg';
    }
  }
}
